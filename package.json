{
  "name": "cozybrowsin",
  "version": "0.2.0",
  "private": true,
  "description": "A minimal Chromium browser with tabs and Brave's ad blocker, for personal use.",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "fetch-filters": "node scripts/fetch-filters.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "author": "CoolGuy",
  "build": {
    "appId": "local.cozybrowsin.app",
    "productName": "CozyBrowsin",
    "files": [
      "main.js",
      "updater.js",
      "tabs.js",
      "adblock.js",
      "adblock-preload.js",
      "strip/**",
      "!**/node_modules/adblock-rs/{target,src,benches,fuzz,data}/**",
      "!**/node_modules/adblock-rs/js/{src,test}/**",
      "!**/node_modules/adblock-rs/{Cargo.lock,Cargo.toml,rust-toolchain.toml,rustfmt.toml,CHANGELOG.md,README.md}"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "CozyBrowsin-${version}-${arch}.${ext}",
    "publish": {
      "provider": "generic",
      "url": "${env.COZYBROWSIN_UPDATE_URL}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "extraResources": [
      {
        "from": "filters",
        "to": "filters"
      }
    ]
  },
  "dependencies": {
    "adblock-rs": "0.13.5",
    "electron-updater": "6.8.11"
  }
}
